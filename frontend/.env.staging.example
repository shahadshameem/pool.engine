# ==============================================================================
# Waymate Frontend - Isolated Staging Environment Template
# ==============================================================================
# Safe template for local/staging verification against Pool Engine.
# Copy this file to .env.staging or use with Vite staging mode.
# DO NOT add private API secrets, database credentials, or service keys to VITE_ variables!
# ==============================================================================

# Pool Engine Integration Toggle
# In staging verification, enable Pool Engine to test host-ride creation and proposals:
VITE_USE_POOL_ENGINE=true

# Staging Pool Engine Service URL (pointing to local isolated backend)
VITE_POOL_ENGINE_URL=http://127.0.0.1:8000

# Firebase Project Configuration (Matches backend FIREBASE_PROJECT_ID)
VITE_FIREBASE_PROJECT_ID=waymate-v3
VITE_FIREBASE_AUTH_DOMAIN=waymate-v3.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=waymate-v3.firebasestorage.app
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps JavaScript API Key (for RouteSelector and location picking)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Firebase Cloud Messaging VAPID Key (Optional, for web push notifications)
VITE_FIREBASE_VAPID_KEY=

# Local Emulators (set false when verifying against real staging Firebase project)
VITE_USE_EMULATOR=false

# Authorized administrator emails for admin dashboard access (comma-separated)
VITE_ADMIN_EMAILS=admin.staging@waymate.internal
