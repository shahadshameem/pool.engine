VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=G-

# Required for the map/location picker.
VITE_GOOGLE_MAPS_API_KEY=

# Required for browser push notifications. Generate this in Firebase Console.
VITE_FIREBASE_VAPID_KEY=

# Set to true only when running the Firebase Auth and Firestore emulators.
VITE_USE_EMULATOR=false

# Authorized administrator emails for admin dashboard access (comma-separated)
VITE_ADMIN_EMAILS=admin@university.edu
