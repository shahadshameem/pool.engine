# ==============================================================================
# Pool Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# Never commit production secrets, private keys, or credentials to version control.
# ==============================================================================

# Runtime Environment (development, testing, staging, production)
# In production, AUTH_ENABLED must be true if API_KEYS is provided.
ENVIRONMENT=development

# Network Bind Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# Security & Authentication
# When true, non-public endpoints require an Authorization: Bearer <key> header.
# Public endpoints (/health, /live, /ready) remain unauthenticated.
AUTH_ENABLED=false

# API Keys Configuration
# Can be configured as JSON: {"admin-token": ["admin-user", ["admin"]], "viewer-token": ["viewer-user", ["read"]]}
# Or as comma-delimited tokens: admin-secret-key:admin,client-secret-key:read
API_KEYS=

# Storage Configuration
# If DATABASE_URL is unset or empty, the service uses an in-memory storage provider.
# For production/staging, provide a PostgreSQL connection URI:
# DATABASE_URL=postgresql://pool_user:pool_password@localhost:5432/pool_engine
DATABASE_URL=

# Routing Provider Configuration
# If OSRM_BASE_URL is unset or empty, the service uses a simulated haversine routing provider.
# For road-network routing, supply the base URL of a running OSRM routed instance:
# OSRM_BASE_URL=http://localhost:5000
OSRM_BASE_URL=

# Routing Timeout (seconds per batch matrix query)
ROUTING_TIMEOUT_SECONDS=0.45

# Dispatch Optimization Controls
# Maximum batch size per dispatch solving window
MAX_BATCH_SIZE=500
# Default execution deadline for a dispatch run (seconds)
DEFAULT_DISPATCH_TIMEOUT_SECONDS=0.5

# Operational Controls
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_SECONDS=10.0
METRICS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
