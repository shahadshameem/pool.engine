# ==============================================================================
# Pool Engine — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on the Contabo VPS.
# Populate PRODUCTION_DB_PASSWORD with a strong random secret.
# NEVER commit .env.production or credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=production

# Database Credentials (Internal Docker network only)
PRODUCTION_DB_PASSWORD=replace_with_strong_random_database_password_32chars

# Firebase Authentication (Cryptographic end-user ID token verification)
AUTH_ENABLED=true
FIREBASE_PROJECT_ID=waymate-u

# Server-to-Server API Keys for dispatch operators (Optional)
# Format: token1:role1,token2:role2 or {"token": ["subject_id", ["admin"]]}
API_KEYS=

# CORS Allowed Origins (Comma-delimited production frontends)
CORS_ALLOWED_ORIGINS=https://waymate-u.web.app,https://waymate-u.firebaseapp.com,https://waymate.in

# Regional Routing Controls
ROUTING_REGIONS_FILE=config/regions.production.json
REQUIRE_REAL_ROUTING=true
STRICT_ROUTING_READINESS=true

# Operational Ceilings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=10.0
ROUTING_TIMEOUT_SECONDS=0.500
SHUTDOWN_TIMEOUT_SECONDS=5.0
