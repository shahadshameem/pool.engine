# ==============================================================================
# Pool Engine — Staging Multi-Region Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=staging
PORT=8000
HOST=0.0.0.0

# Persistent PostgreSQL Storage (Port 5433 for local portable PostgreSQL or 5432 in standard staging)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/pool_engine_staging
REQUIRE_PERSISTENT_STORAGE=true
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=10.0

# Multi-Region Road-Network Routing Configuration
REQUIRE_REAL_ROUTING=true
ROUTING_REGIONS_FILE=config/regions.json
ROUTING_MAX_SNAP_DISTANCE_METERS=5000.0
ROUTING_TIMEOUT_SECONDS=0.500

# Health & Operational Readiness
# In multi-region deployments, strict readiness set to false prevents a single offline
# regional backend from taking down traffic serving other operational regions.
STRICT_ROUTING_READINESS=false

# Security & CORS
REQUIRE_AUTH=false
ALLOW_UNAUTHENTICATED_IN_PRODUCTION=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Privacy & Telemetry
MASK_COORDINATES_IN_LOGS=true
ENABLE_TELEMETRY=true
SHUTDOWN_TIMEOUT_SECONDS=5.0
