# ==============================================================================
# Pool Engine - Isolated Staging Environment Template
# ==============================================================================
# Safe template for persistent local/staging verification (zero cost, non-production).
# Copy this file to .env.staging (or .env) when running staging verification.
# DO NOT commit real secrets, passwords, or service-account JSON keys to version control.
# ==============================================================================

# Runtime Environment
ENVIRONMENT=staging

# Network Bind Configuration (Run staging Pool Engine on port 8000)
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000

# Security & Authentication Controls
# In staging, AUTH_ENABLED is set to true to verify genuine Firebase ID tokens.
AUTH_ENABLED=true
AUTH_PROVIDER_TYPE=firebase

# Firebase Authentication (End-user ID token cryptographic verification)
# Must match your Firebase project ID exactly (e.g. waymate-v3)
FIREBASE_PROJECT_ID=waymate-v3

# Optional: Path to Firebase service account JSON key file (for local admin verification)
# Leave empty to rely on Google Application Default Credentials or public cert validation
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CHECK_REVOKED=false

# CORS Allowed Origins
# Permit local frontend origins only. Do NOT use wildcards in staging or production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Configuration & Persistence Guardrails
# For staging persistence, supply a dedicated non-production PostgreSQL connection string:
# Format: postgresql://<staging_user>:<staging_password>@127.0.0.1:5432/<staging_db>
DATABASE_URL=postgresql://pool_staging_user:staging_password@127.0.0.1:5432/pool_engine_staging

# Isolated Test Database for automated integration tests (truncated on test runs)
TEST_DATABASE_URL=postgresql://pool_staging_user:staging_password@127.0.0.1:5432/pool_engine_test

# Safety Guard: Set to true in staging to prevent silent fallback to in-memory storage!
REQUIRE_PERSISTENT_STORAGE=true

# Routing Provider Configuration
# Set to the base URL of the Kerala OSRM service (running on port 5001 to avoid colliding with NYC on 5000):
OSRM_BASE_URL=http://127.0.0.1:5001

# Safety Guard: Set to true in staging to prevent silent fallback to mock haversine routing!
REQUIRE_REAL_ROUTING=true
STRICT_ROUTING_READINESS=true

# Routing Timeout (seconds per query)
ROUTING_TIMEOUT_SECONDS=0.50

# Dispatch Optimization Controls
MAX_BATCH_SIZE=500
DEFAULT_DISPATCH_TIMEOUT_SECONDS=0.50

# Operational Controls
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_SECONDS=5.0
ENABLE_TELEMETRY=true
LOG_LEVEL=INFO
